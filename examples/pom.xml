<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.juherr.datex4j</groupId>
    <artifactId>datex4j</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>datex4j-examples</artifactId>
  <packaging>jar</packaging>

  <name>datex4j-examples</name>
  <description>Runnable examples demonstrating the datex4j public API. Not published.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.juherr.datex4j</groupId>
      <artifactId>datex4j-xml</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.juherr.datex4j</groupId>
      <artifactId>datex4j-model</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.juherr.datex4j</groupId>
      <artifactId>datex4j-json</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.juherr.datex4j</groupId>
      <artifactId>datex4j-validation</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.juherr.datex4j</groupId>
      <artifactId>datex4j-domain-traffic</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.juherr.datex4j</groupId>
      <artifactId>datex4j-location</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.juherr.datex4j</groupId>
      <artifactId>datex4j-ocpi</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>dev.juherr.datex4j.examples.DatexExample</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
