<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.juherr.datex4j</groupId>
    <artifactId>datex4j</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>datex4j-domain-evcharging</artifactId>
  <packaging>jar</packaging>

  <name>datex4j-evcharging</name>
  <description>
    Convenience builders for the DATEX II EV Charging user domain (energy infrastructure, AFIR).
  </description>

  <dependencies>
    <dependency>
      <groupId>dev.juherr.datex4j</groupId>
      <artifactId>datex4j-builders</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.juherr.datex4j</groupId>
      <artifactId>datex4j-model-v3_7</artifactId>
    </dependency>

    <dependency>
      <groupId>dev.juherr.datex4j</groupId>
      <artifactId>datex4j-xml</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>dev.juherr.datex4j.domain.evcharging</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
