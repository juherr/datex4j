<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.juherr.datex4j</groupId>
    <artifactId>datex4j</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>datex4j-model-spi</artifactId>
  <packaging>jar</packaging>

  <name>datex4j-model-spi</name>
  <description>
    Service Provider Interface consumed by the datex4j facades to discover the generated DATEX II
    model of a given version at runtime. Each datex4j-model-vX_Y module ships one implementation,
    registered through java.util.ServiceLoader.
  </description>

  <dependencies>
    <dependency>
      <groupId>dev.juherr.datex4j</groupId>
      <artifactId>datex4j-core</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>dev.juherr.datex4j.model.spi</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
